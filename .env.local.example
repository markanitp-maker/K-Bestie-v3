# Supabase — 브라우저 허용 (URL + anon key만)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase — 서버 전용 (절대 NEXT_PUBLIC_ 금지)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Gemini Live API — 서버 전용
GEMINI_API_KEY=AIza...

# Vertex Live 릴레이(Cloud Run, services/vertex-live-relay) — 그룹C가 Vertex로 전환됐을 때만 사용.
# provider_switch_settings 그룹C가 ai_studio면 아래 값은 안 쓰임(기존 AI Studio 경로 그대로).
# VERTEX_LIVE_RELAY_URL=wss://<cloud-run-service>.run.app/live
# VERTEX_LIVE_RELAY_SECRET=<services/vertex-live-relay의 .env와 동일한 값>

# Vertex AI 전환(그룹A/B/C 공통) — 서버 전용, GCP_BILLING_SA_KEY_JSON과 완전 분리
# GCP_VERTEX_SA_KEY_JSON={"type":"service_account",...}
# GOOGLE_CLOUD_PROJECT=k-bestie3
# GOOGLE_CLOUD_LOCATION=us-west1

# Gemma — 서버 전용
GEMMA_API_KEY=AIza...

# GCP Speech-to-Text — 서버 전용 (아이 발화 전사, 자유대화·미션 공통 — 주기적 recognize 호출)
GCP_STT_API_KEY=AIza...

# GCP Text-to-Speech — 서버 전용 (케이 발화 합성, ko-KR-Wavenet-* 등급만 사용)
GCP_TTS_API_KEY=AIza...

# 관리자 대시보드 화이트리스트 — 콤마 구분 이메일 목록, 서버 전용
# ADMIN_EMAILS=admin1@example.com,admin2@example.com

# 아이 화면 진입 시간 제한(운영시간 게이트, /child/missions) on/off — 서버 전용.
# 값 없으면 기본 true(기존 제한 정상 적용). 테스트 기간에만 false로 설정할 것 —
# 정상 서비스 전환 시 이 줄을 지우거나 true로 바꾸면 즉시 복원된다.
# CHILD_TIME_RESTRICTIONS_ENABLED=false

# 질문·대화 엔진 V2 (PR2) 설정
# QUESTION_ENGINE_V2: true이면 질문·대화 엔진 V2를 활성화한다. 기본값은 false.
# QUESTION_ENGINE_V2=false
# QUESTION_ENGINE_V2_SEED_CHILD_IDS: 질문·대화 엔진 V2가 활성화(true)되어 있을 때, 신규 로직을 적용할 대상 아동(child_id)의 UUID 목록 (콤마 구분).
# QUESTION_ENGINE_V2_SEED_CHILD_IDS=uuid1,uuid2

# GCP billing_export(BigQuery) — 관리자 대시보드 STT/TTS 실제 청구액 조회용, 서버 전용
# 조회 전용 서비스 계정에 필요한 권한: 데이터세트 BigQuery Data Viewer + 프로젝트 BigQuery Job User
# GCP_BILLING_PROJECT_ID=K-Bestie3
# GCP_BILLING_DATASET=billing_export
# GCP_BILLING_SA_KEY_JSON={"type":"service_account",...}

# MBTI 놀이 ↔ 독립 MBTI 프로젝트 연결(딥 인터뷰 확정,
# .omc/specs/deep-interview-mbti-platform-connection.md) — 둘 다 서버 전용,
# NEXT_PUBLIC_ 접두사 절대 금지, 클라이언트 번들에 노출되면 안 됨.
# MBTI_UPSTREAM_ORIGIN: 독립 MBTI 프로젝트의 실제 Vercel 배포 Origin. app/play/mbti/
# [[...path]]/route.ts(Route Handler)가 /play/mbti 요청을 이 값으로 프록시한다
# (2026-08 CSP frame-ancestors 장애 수정으로 next.config.ts rewrite에서 이관됨).
# Dev: k-bestie-mbti-dev.vercel.app
# MBTI_UPSTREAM_ORIGIN=https://k-bestie-mbti-dev.vercel.app
# MBTI_INTERNAL_API_KEY: 독립 MBTI 프로젝트 서버가 /api/internal/play/* 호출 시 사용하는
# 서버 전용 자격증명(Authorization: Bearer). 양쪽 프로젝트 env에 동일 값으로 설정해야 함.
# MBTI_INTERNAL_API_KEY=

# QuizMaster 놀이 ↔ 독립 Quiz 프로젝트 연결(계획 .omc/plans/quizmaster-resplit-plan.md
# Phase 3/4 + 보안 리뷰 task #45) — 전부 서버 전용, NEXT_PUBLIC_ 접두사 절대 금지.
# QUIZ_UPSTREAM_ORIGIN: 독립 Quiz 프로젝트의 실제 Vercel 배포 Origin.
# app/api/quiz-proxy/[[...path]]/route.ts가 /play/quiz 요청을 이 값으로 프록시한다.
# Dev: k-bestie-quiz-dev.vercel.app (미설정 시 프록시는 503을 반환한다 — fail-closed)
# QUIZ_UPSTREAM_ORIGIN=https://k-bestie-quiz-dev.vercel.app
#
# QUIZ_INTERNAL_AUTH_SECRET: K-Bestie 프록시 ↔ Quiz 앱 서버간 공유 시크릿.
# 프록시가 모든 forwarded 요청(정적 자산 포함)에 x-quiz-proxy-auth 헤더로 붙이고,
# Quiz 앱 middleware가 timing-safe 비교 후 불일치/누락이면 404를 반환한다. 이게 있어야
# raw k-bestie-quiz-dev.vercel.app URL이 최종 사용자에게 직접 사용 불가능해진다.
# **양쪽 프로젝트에 동일한 값**으로 설정해야 하며, 미설정 시 프록시는 503(fail-closed).
# 절대 쿠키/쿼리/클라이언트 번들로 내보내지 말 것 — 헤더 전용.
# QUIZ_INTERNAL_AUTH_SECRET=
#
# QUIZ_PROXY_DEFAULT: /play/quiz has-게이트의 기본값. "on"이면 quiz_proxy 쿠키가 없는
# 요청도 프록시로 간다(= 컷오버). 그 외 값/미설정이면 기본 OFF라 기존 인앱 구현
# (app/play/quiz/page.tsx)이 서빙된다. 쿠키 quiz_proxy=on/off가 항상 이 값보다 우선하며
# 이게 즉시 롤백 레버다. **E2E 통과 전까지 설정하지 말 것.**
# 주의: 이 게이트는 롤아웃 스위치일 뿐 보안 경계가 아니다 — 프록시는 게이트와 무관하게
# K-Bestie 인증 세션을 별도로 요구한다.
# QUIZ_PROXY_DEFAULT=off
#
# QUIZ_UPSTREAM_BYPASS_SECRET: Quiz dev 배포에 Deployment Protection이 켜져 있을 때
# 프록시가 x-vercel-protection-bypass 헤더로 첨부하는 값(Quiz 프로젝트에서 발급).
# K-Bestie 자신의 시스템 주입 변수 VERCEL_AUTOMATION_BYPASS_SECRET과는 다른 값이며,
# 그걸 업스트림으로 전달해서는 안 된다. VERCEL_ENV=production에서는 전송하지 않는다.
# QUIZ_UPSTREAM_BYPASS_SECRET=

# LLM 모델 중앙 라우팅 역할별 매핑
# LLM_MODEL_PREMIUM_LIVE_VOICE=gemini-live-2.5-flash-native-audio
