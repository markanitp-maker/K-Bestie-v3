# LLM_MODEL_MISSION_REACTION_FALLBACK=gemini-3.5-flash
# LLM_MODEL_MISSION_MEMORY_GREETING=gemini-3.5-flash-lite
# LLM_MODEL_FREECHAT_MEMORY_RECALL=gemini-3.5-flash-lite
# LLM_MODEL_PARENT_MEMORY_QUERY=gemini-3.5-flash-lite
# LLM_MODEL_MISSION_GENERAL=gemini-3.5-flash
# LLM_MODEL_CHILD_CLASSIFICATION=gemini-3.5-flash
